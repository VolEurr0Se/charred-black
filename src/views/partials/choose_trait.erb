<div class='modal-header'>
  <h3 class='modal-title'><%= t(%q{Add Trait}) %></h3>
</div>
<div class='modal-body'>
  <strong><%= t(%q{Remaining:}) %></strong>
  <%= t(%q{{{unspentTraitPoints}}/{{totalTraitPoints}} pts}) %>
  <br>
  <br>
  <p>
    <select class='form-control' ng-model='data.currentTrait' ng-options='s.nameForListDisplay for s in filteredTraits()' size='10'></select>
  </p>
  <well ng-show='(data.currentTrait.name | trTraitDesc:data.currentTrait.desc)'>
    <strong><%= t(%q{Description:}) %></strong>
    {{data.currentTrait.name | trTraitDesc:data.currentTrait.desc}}
  </well>
  <h4><%= t(%q{Filter By}) %></h4>
  <div class='container'>
    <div class='row'>
      <div class='col-md-2'>
        <%= t(%q{Type:}) %>
        <select class='form-control' ng-model='filters.typeFilter'>
          <option value=''><%= t(%q{(unfiltered)}) %></option>
          <option value='character'><%= t(%q{Character}) %></option>
          <option value='die'><%= t(%q{Die}) %></option>
          <option value='call_on'><%= t(%q{Call-On}) %></option>
        </select>
      </div>
      <div class='col-md-2'>
        <%= t(%q{Cost:}) %>
        <input class='form-control' id='cost' ng-model='filters.costFilter' placeholder="<%= t(%q{'&lt; 2' or '&gt; 3' or '= 5'}) %>" type='text'>
      </div>
      <div class='col-md-2'>
        <%= t(%q{Can Afford:}) %>
        <input ng-model='filters.canAfford' type='checkbox'>
      </div>
    </div>
  </div>
</div>
<div class='modal-footer'>
  <button class='btn btn-primary' ng-click='ok(characterIdAndName)'><%= t(%q{OK}) %></button>
  <button class='btn btn-warning' ng-click='cancel()'><%= t(%q{Cancel}) %></button>
</div>