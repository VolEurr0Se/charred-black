<div class='modal-header'>
  <h3 class='modal-title'><%= t(%q{Choose Appropriate Weapons}) %></h3>
</div>
<div class='modal-body'>
  <p>
    <%= t(%q{The lifepath '{{lifepathName}}' contains the Appropriate Weapons skill, which is a placeholder for a list of all weapons that make sense for '{{lifepathName}}' to have in your campaign.}) %>
  </p>
  <p>
    <%= t(%q{Please choose which weapons are appropriate in your campaign:}) %>
  </p>
  <p ng-repeat='w in weaponSkillsNames()'>
    <input ng-model='chosen[w]' type='checkbox'>
    {{w | tr}}
  </p>
</div>
<div class='modal-footer'>
  <button class='btn btn-primary' ng-click='ok()'><%= t(%q{OK}) %></button>
  <button class='btn btn-warning' ng-click='cancel()'><%= t(%q{Cancel}) %></button>
</div>