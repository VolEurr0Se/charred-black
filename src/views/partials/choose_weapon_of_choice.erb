<div class='modal-header'>
  <h3 class='modal-title'><%= t(%q{Choose a Weapon}) %></h3>
</div>
<div class='modal-body'>
  <p>
    <%= t(%q{The lifepath '{{lifepathName}}' contains the Weapon Of Choice skill, which is a placeholder for a weapon that makes sense for '{{lifepathName}}' to have in your campaign and that fits with the character.}) %>
  </p>
  <p>
    <%= t(%q{Please choose the weapon:}) %>
  </p>
  <select ng-model='chosen[0]' ng-options='i as (i | tr) for i in weaponSkillsNames()'></select>
</div>
<div class='modal-footer'>
  <button class='btn btn-primary' ng-click='ok()'><%= t(%q{OK}) %></button>
  <button class='btn btn-warning' ng-click='cancel()'><%= t(%q{Cancel}) %></button>
</div>