<div class='panel-group' id='accordion_main'>
  <div class='panel panel-default'>
    <div class='panel-heading'>
      <h4 class='panel-title'>
        <a data-target='#collapse_tools' data-toggle='collapse' href=''>
          <%= t(%q{Tools}) %>
        </a>
      </h4>
    </div>
    <div class='panel-collapse collapse in' id='collapse_tools'>
      <div class='panel-body'>
        <div class='alert alert-danger alert-dismissable' ng-repeat="warn in alertsOfType('tools', 'warn')">
          <button aria-hidden='true' class='close' ng-click="removeAlert('tools',warn)" type='button'>&times;</button>
          {{warn}}
        </div>
        <div class='alert alert-success alert-dismissable' ng-repeat="warn in alertsOfType('tools', 'succ')">
          <button aria-hidden='true' class='close' ng-click="removeAlert('tools',warn)" type='button'>&times;</button>
          {{warn}}
        </div>
        <div class='container'>
          <div class='row'>
            <div class='col-md-3'>
              <a href='' ng-click="makeCharsheetForCurrentCharacter('htm')">
                <%= t(%q{Export Character Sheet (.htm)}) %>
              </a>
              |
              <a href='' ng-click="makeCharsheetForCurrentCharacter('docx')">
                <%= t(%q{Word (.docx)}) %>
              </a>
            </div>
            <div class='col-md-2'>
              <a href='' ng-click='onStockChange()'>
                <%= t(%q{Reset Character}) %>
              </a>
            </div>
            <div class='col-md-2' ng-show="serverSettings.storageType == 'server'">
              <a href='' ng-click='saveCurrentCharacterToServer()'>
                <%= t(%q{Save Character}) %>
              </a>
            </div>
            <div class='col-md-2' ng-show="serverSettings.storageType == 'server'">
              <a href='' ng-click='chooseCharacterToLoad()'>
                <%= t(%q{Load Character...}) %>
              </a>
            </div>
            <div class='col-md-2' ng-show="serverSettings.storageType == 'server'">
              <a href='' ng-click='chooseCharacterToDelete()'>
                <%= t(%q{Delete Character...}) %>
              </a>
            </div>
            <div class='col-md-2' ng-show="serverSettings.storageType != 'server'">
              <a href='' ng-click='downloadCurrentCharacter()'>
                <%= t(%q{Download Character}) %>
              </a>
            </div>
            <div class='col-md-2' ng-show="serverSettings.storageType != 'server'">
              <a href='' ng-click='showUploadCharacterModal()'>
                <%= t(%q{Upload Character...}) %>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class='panel-heading'>
      <h4 class='panel-title'>
        <a data-target='#collapse_first' data-toggle='collapse' href=''>
          <%= t(%q{Character}) %>
        </a>
      </h4>
    </div>
    <div class='panel-collapse collapse in' id='collapse_first'>
      <div class='panel-body'>
        <div class='container'>
          <div class='row'>
            <div class='col-md-1'>
              <strong><%= t(%q{Name:}) %></strong>
            </div>
            <div class='col-md-2'>
              <input class='form-control' id='name' ng-model='name' type='text'>
            </div>
            <div class='col-md-1'>
              <a href='' ng-click='generateName()'><%= t(%q{Gen}) %></a>
            </div>
            <div class='col-md-1'>
              <strong>
                <%= t(%q{Stock:}) %>
              </strong>
            </div>
            <div class='col-md-2'>
              <select class='form-control' ng-change='onStockChange()' ng-model='stock'>
                <option value='man'><%= t(%q{Man}) %></option>
                <option value='dwarf'><%= t(%q{Dwarf}) %></option>
                <option value='elf'><%= t(%q{Elf}) %></option>
                <option value='orc'><%= t(%q{Orc}) %></option>
                <option value='roden'><%= t(%q{Roden}) %></option>
                <option value='wolf'><%= t(%q{Great Wolf}) %></option>
                <option value='troll'><%= t(%q{Troll}) %></option>
              </select>
            </div>
            <div class='col-md-1'>
              <strong>
                <%= t(%q{Age:}) %>
              </strong>
              {{age}}
            </div>
            <div class='col-md-1'>
              <strong>
                <%= t(%q{Gender:}) %>
              </strong>
            </div>
            <div class='col-md-2'>
              <select class='form-control' ng-change='onGenderChange()' ng-model='gender'>
                <option value='female'><%= t(%q{female}) %></option>
                <option value='male'><%= t(%q{male}) %></option>
              </select>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class='panel-heading'>
      <h4 class='panel-title'>
        <a data-target='#collapse_lp' data-toggle='collapse' href=''>
          <%= t(%q{Lifepaths}) %>
        </a>
      </h4>
    </div>
    <div class='panel-collapse collapse in' id='collapse_lp'>
      <div class='panel-body'>
        <div class='list-group'>
          <div class='list-group-item' ng-repeat='lp in selectedLifepaths'>
            <div class='container-fluid'>
              <div class='row'>
                <div class='col-md-3'>
                  <div class='h4'>{{lp.displayName | tr}}</div>
                </div>
                <div class='col-md-1' ng-show='lp.timeIsChoosable'>
                  <span>
                    <input max='{{lp.timeRange.max}}' min='{{lp.timeRange.min}}' ng-change='onLifepathTimeChange(lp)' ng-model='lp.time' required='' style='width: 3em;' type='number'>
                  </span>
                  <span>
                    <%= t(%q{yrs}) %>
                  </span>
                </div>
                <div class='col-md-1' ng-hide='lp.timeIsChoosable'><%= t(%q{{{lp.time}} yrs}) %></div>
                <div class='col-md-1'><%= t(%q{{{lp.resourcePts}} res}) %></div>
                <div class='col-md-2'>{{lp.displayStat()}}</div>
                <div class='col-md-3'>{{lp.displayLeads()}}</div>
                <div class='col-md-1' ng-show='$last'>
                  <a href='' ng-click='onRemoveLifepathClick(lp)'><%= t(%q{remove}) %></a>
                </div>
              </div>
              <div class='row'>
                <div class='col-md-1'>&nbsp;</div>
              </div>
              <div class='row'>
                <div class='col-md-1'></div>
                <div class='col-md-7'>
                  <strong>
                    <%= t(%q{Skills:}) %>
                  </strong>
                  {{lp.displaySkills()}}
                </div>
              </div>
              <div class='row'>
                <div class='col-md-1'></div>
                <div class='col-md-7'>
                  <strong>
                    <%= t(%q{Traits:}) %>
                  </strong>
                  <%= t(%q{{{lp.traitPts}} pt: {{lp.displayTraits()}}}) %>
                </div>
              </div>
              <div class='row' ng-show='lp.requires'>
                <div class='col-md-1'></div>
                <div class='col-md-7'>
                  <strong><%= t(%q{Requires:}) %></strong>
                  {{lp.requires | tr}}
                </div>
              </div>
              <div class='row' ng-show='lp.restrict'>
                <div class='col-md-1'></div>
                <div class='col-md-7'>
                  <strong><%= t(%q{Restrictions:}) %></strong>
                  {{lp.restrict | tr}}
                </div>
              </div>
              <div class='row' ng-show='lp.note'>
                <div class='col-md-1'></div>
                <div class='col-md-7'>
                  <strong><%= t(%q{Note:}) %></strong>
                  {{lp.note | tr}}
                </div>
              </div>
              <div class='row' ng-show="stock == 'orc' &amp;&amp; lp.brutalLifeDOF != 0">
                <div class='col-md-1'></div>
                <div class='col-md-7'>
                  <strong><%= t(%q{Brutal Life:}) %></strong>
                  <%= t(%q{Die of Fate roll was {{lp.brutalLifeDOF}}.}) %>
                  <span ng-show='lp.brutalLifeTraitName'><%= t(%q{Unfortunately, you gained the {{lp.brutalLifeTraitName}} trait.}) %></span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <h4><%= t(%q{Add Lifepath}) %></h4>
        <div class='container'>
          <div class='row' ng-hide='brutalLifeWithdrawn'>
            <div class='col-md-3'>
              <select class='form-control' ng-change='onSettingChange()' ng-model='currentSetting' ng-options='s as (s | tr) for s in settingNames'></select>
            </div>
            <div class='col-md-3'>
              <select class='form-control' ng-model='currentSettingLifepath' ng-options="s as (s | tr) for s in currentSettingLifepathNames | orderBy:'toString()'"></select>
            </div>
            <div class='col-md-1'>
              <a href='' ng-click='onAddLifepathClick()'><%= t(%q{Add}) %></a>
            </div>
          </div>
          <div class='row' ng-show='brutalLifeWithdrawn'>
            <div class='col-md-6'>
              <%= t(%q{You've removed a lifepath where the Brutal Life rules caused an unsavoury trait. Removing the lifepath means your character chose to bow and prostrate before his betters, and cannot progress any further in character burning.}) %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class='panel-heading' ng-show='age &gt; 0'>
      <h4 class='panel-title'>
        <a data-target='#collapse_stats' data-toggle='collapse' href=''>
          <%= t(%q{Stats and Attributes}) %>
        </a>
      </h4>
    </div>
    <div class='panel-collapse collapse in' id='collapse_stats' ng-show='age &gt; 0'>
      <div class='panel-body'>
        <div class='container'>
          <div class='row'>
            <div class='col-md-5'>
              <strong><%= t(%q{Remaining:}) %></strong>
              <%= t(%q{Physical: {{unspentStatPoints.physical}}/{{totalStatPoints.physical}} pts, Mental: {{unspentStatPoints.mental}}/{{totalStatPoints.mental}} pts, Either: {{unspentStatPoints.either}}/{{totalStatPoints.either}} pts}) %>
            </div>
          </div>
          <div class='row'>
            <div class='col-md-1'>
              <br>
            </div>
          </div>
          <div class='row'>
            <div class='col-md-1'>
              <button class='btn btn-default btn-sm' ng-click='distributeStats()'><%= t(%q{Distribute}) %></button>
            </div>
          </div>
          <div class='row'>
            <div class='col-md-1'>
              <br>
            </div>
          </div>
          <div class='row'>
            <div class='col-md-5'>
              <div class='row' ng-repeat='stat in stats'>
                <div class='col-md-3'>
                  {{stat.name | tr}}
                </div>
                <div class='col-md-3'>
                  <button class='btn btn-default btn-xs' ng-click='changeStatShade(stat)'>{{stat.shade}}</button>
                  {{stat.exp()}}
                  <div class='btn-group'>
                    <button class='btn btn-default btn-xs' ng-click='incrementStat(stat)'>+</button>
                    <button class='btn btn-default btn-xs' ng-click='decrementStat(stat)'>-</button>
                  </div>
                </div>
              </div>
            </div>
            <div class='col-md-7'>
              <div class='row' ng-repeat='attrname in attributeNames()'>
                <div class='col-md-4'>
                  {{attrname | tr}}
                </div>
                <div class='col-md-2'>
                  <span ng-show='attributeShade[attrname]'>
                    <button class='btn btn-default btn-xs' ng-click='changeAttributeShade(attrname)'>{{attribute(attrname).shade}}</button>
                  </span>
                  <span ng-hide='attributeShade[attrname]'>
                    {{attribute(attrname).shade}}
                  </span>
                  {{attribute(attrname).exp}}
                </div>
                <div class='col-md-1' ng-show='attribute(attrname).modifyable'>
                  <a href='' ng-click='answerEmotionalAttributeQuestions(attrname)'><%= t(%q{modify}) %></a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class='panel-heading' ng-show='age &gt; 0'>
      <h4 class='panel-title'>
        <a data-target='#collapse_ptgs' data-toggle='collapse' href=''>
          <%= t(%q{Physical Tolerances Grayscale}) %>
        </a>
      </h4>
    </div>
    <div class='panel-collapse collapse in' id='collapse_ptgs' ng-show='age &gt; 0'>
      <div class='panel-body'>
        <div class='container'>
          <div class='row'>
            <div class='col-md-2'>
              <table class='table table-condensed'>
                <tr>
                  <th><%= t(%q{Su}) %></th>
                  <th><%= t(%q{Li}) %></th>
                  <th><%= t(%q{Mi}) %></th>
                  <th><%= t(%q{Se}) %></th>
                  <th><%= t(%q{Tr}) %></th>
                  <th><%= t(%q{Mo}) %></th>
                </tr>
                <tr>
                  <td>B{{ptgs.su}}</td>
                  <td>B{{ptgs.li}}</td>
                  <td>B{{ptgs.mi}}</td>
                  <td>B{{ptgs.se}}</td>
                  <td>B{{ptgs.tr}}</td>
                  <td>B{{ptgs.mo}}</td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class='panel-heading' ng-show='age &gt; 0'>
      <h4 class='panel-title'>
        <a data-target='#collapse_skills' data-toggle='collapse' href=''>
          <%= t(%q{Skills}) %>
        </a>
      </h4>
    </div>
    <div class='panel-collapse collapse in' id='collapse_skills' ng-show='age &gt; 0'>
      <div class='panel-body'>
        <strong><%= t(%q{Remaining:}) %></strong>
        <%= t(%q{Lifepath: {{unspentSkillPoints.lifepath}}/{{totalSkillPoints.lifepath}} pts, General: {{unspentSkillPoints.general}}/{{totalSkillPoints.general}} pts}) %>
        <br>
        <br>
        <ul class='list-group' id='skills-list-group' ng-show='hashValues(allSelectedSkills()).length &gt; 0'>
          <li class='list-group-item'>
            <div class='container'>
              <div class='row'>
                <div class='col-md-2'>
                  <strong><%= t(%q{Name}) %></strong>
                </div>
                <div class='col-md-2'>
                  <strong><%= t(%q{Root}) %></strong>
                </div>
                <div class='col-md-2'>
                  <strong><%= t(%q{Shade and Exponent}) %></strong>
                </div>
                <div class='col-md-2'>
                  <strong><%= t(%q{Notes}) %></strong>
                </div>
              </div>
            </div>
          </li>
          <!-- / Attempt to color skills that have exp > 0 -->
          <!-- /%li{ :class => "list-group-item", "ng-repeat" => "skill in hashValues(allSelectedSkills) | orderBy:'name'", "ng-class" => "{highlight: exp() > 0}" } -->
          <li class='list-group-item' ng-repeat="skill in hashValues(allSelectedSkills()) | orderBy:'name'">
            <div class='container'>
              <div class='row'>
                <div class='col-md-2'>
                  <span ng-style='skillStyle(skill)'>
                    {{skill.name | tr}}
                  </span>
                </div>
                <div class='col-md-2'>
                  {{skill.displayRoots()}}
                </div>
                <div class='col-md-2' ng-hide='skill.isTraining'>
                  {{skill.shade(statsForSkillCalc)}} {{skill.exp(statsForSkillCalc)}}
                  <div class='btn-group'>
                    <button class='btn btn-default btn-xs' ng-click='incrementSkill(skill)'>+</button>
                    <button class='btn btn-default btn-xs' ng-click='decrementSkill(skill)'>-</button>
                  </div>
                </div>
                <div class='col-md-2' ng-show='skill.isTraining'>
                  <input ng-checked='skill.pointsSpent() &gt; 0' ng-click='changeTrainingSkill($event, skill)' type='checkbox'>
                </div>
                <div class='col-md-2'>
                  {{skill.notes()}}
                </div>
                <div class='col-md-1' ng-show='isGeneralSkill(skill)'>
                  <button class='btn btn-default btn-xs' ng-click='removeGeneralSkill(skill)'><%= t(%q{remove}) %></button>
                </div>
              </div>
            </div>
          </li>
        </ul>
        <div class='container'>
          <div class='row'>
            <div class='col-md-4'>
              <h4><%= t(%q{Add General Skill}) %></h4>
            </div>
            <div class='col-md-4'>
              <h4><%= t(%q{Add Custom -Wise}) %></h4>
            </div>
          </div>
          <div class='row'>
            <div class='col-md-3'>
              <select class='form-control' ng-model='currentGeneralSkill' ng-options='s as (s | tr) for s in selectableGeneralSkills()'></select>
            </div>
            <div class='col-md-1'>
              <a href='' ng-click='addGeneralSkill(currentGeneralSkill)'><%= t(%q{Add}) %></a>
            </div>
            <div class='col-md-3'>
              <input class='form-control' id='customWiseName' ng-model='customWiseName' placeholder="<%= t(%q{Enter '-wise' name}) %>" type='text'>
            </div>
            <div class='col-md-1'>
              <a href='' ng-click='addCustomWise(customWiseName)'><%= t(%q{Add}) %></a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class='panel-heading' ng-show='age &gt; 0'>
      <h4 class='panel-title'>
        <a data-target='#collapse_traits' data-toggle='collapse' href=''>
          <%= t(%q{Traits}) %>
        </a>
      </h4>
    </div>
    <div class='panel-collapse collapse in' id='collapse_traits' ng-show='age &gt; 0'>
      <div class='panel-body'>
        <div class='alert alert-danger' ng-repeat='warn in lifepathTraitWarnings'>{{warn}}</div>
        <div class='alert alert-danger alert-dismissable' ng-repeat="warn in alertsOfType('trait', 'warn')">
          <button aria-hidden='true' class='close' ng-click="removeAlert('trait',warn)" type='button'>&times;</button>
          {{warn}}
        </div>
        <strong><%= t(%q{Remaining:}) %></strong>
        <%= t(%q{{{unspentTraitPoints}}/{{totalTraitPoints}} pts}) %>
        <br>
        <br>
        <ul class='list-group' id='traits-list-group' ng-show='hashValues(commonTraits).length &gt; 0 || hashValues(purchasedTraits).length &gt; 0 ||hashValues(requiredTraits).length &gt; 0'>
          <li class='list-group-item'>
            <div class='container'>
              <div class='row'>
                <div class='col-md-3'>
                  <strong><%= t(%q{Name}) %></strong>
                </div>
                <div class='col-md-2'>
                  <strong><%= t(%q{Type}) %></strong>
                </div>
                <div class='col-md-1'></div>
                <div class='col-md-5'>
                  <strong><%= t(%q{Description}) %></strong>
                </div>
              </div>
            </div>
          </li>
          <li class='list-group-item' ng-repeat="trait in hashValues(commonTraits) | orderBy:'name'">
            <div class='container'>
              <div class='row'>
                <div class='col-md-3' data-placement='top' data-toggle='tooltip' title='{{trait.name | trTraitDesc:trait.desc}}'>
                  {{trait.name | tr}}
                </div>
                <div class='col-md-2'>
                  {{trait.typeForDisplay()}}
                </div>
                <div class='col-md-1'></div>
                <div class='col-md-5'>
                  <p>{{trait.name | trTraitDesc:trait.desc}}</p>
                </div>
              </div>
            </div>
          </li>
          <li class='list-group-item' ng-repeat="trait in hashValues(purchasedTraits) | orderBy:'name'">
            <div class='container'>
              <div class='row'>
                <div class='col-md-3' data-placement='top' data-toggle='tooltip' title='{{trait.name | trTraitDesc:trait.desc}}'>
                  {{trait.name | tr}}
                </div>
                <div class='col-md-2'>
                  {{trait.typeForDisplay()}}
                </div>
                <div class='col-md-1'>
                  <button class='btn btn-default btn-xs' ng-click='removeTrait(trait)'><%= t(%q{remove}) %></button>
                </div>
                <div class='col-md-5'>
                  <p>{{trait.name | trTraitDesc:trait.desc}}</p>
                </div>
              </div>
            </div>
          </li>
          <li class='list-group-item' ng-repeat="trait in hashValues(requiredTraits) | orderBy:'name'">
            <div class='container'>
              <div class='row'>
                <div class='col-md-3' data-placement='top' data-toggle='tooltip' title='{{trait.name | trTraitDesc:trait.desc}}'>
                  {{trait.name | tr}}
                </div>
                <div class='col-md-2'>
                  {{trait.typeForDisplay()}}
                </div>
                <div class='col-md-1'></div>
                <div class='col-md-5'>
                  <p>{{trait.name | trTraitDesc:trait.desc}}</p>
                </div>
              </div>
            </div>
          </li>
        </ul>
        <div class='container'>
          <div class='row'>
            <div class='col-md-4'>
              <h4><%= t(%q{Add Trait from Lifepaths}) %></h4>
            </div>
            <div class='col-md-4'>
              <h4><%= t(%q{Add Special Trait}) %></h4>
            </div>
          </div>
          <div class='row'>
            <div class='col-md-3'>
              <select class='form-control' ng-model='currentLifepathTrait' ng-options='s as (s | trLifepathTrait) for s in lifepathTraitsForDisplay()'></select>
            </div>
            <div class='col-md-1'>
              <a href='' ng-click='addLifepathTrait(currentLifepathTrait)'><%= t(%q{Add}) %></a>
            </div>
            <div class='col-md-3'>
              <select class='form-control' ng-model='currentSpecialTrait' ng-options='s.nameForListDisplay for s in specialTraitsForDisplay'></select>
            </div>
            <div class='col-md-3'>
              <a href='' ng-click='addSpecialTrait(currentSpecialTrait)'><%= t(%q{Add}) %></a>
              |
              <a href='' ng-click='chooseTraitUsingAdvancedSearch()'><%= t(%q{Search traits...}) %></a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class='panel-heading' ng-show='age &gt; 0'>
      <h4 class='panel-title'>
        <a data-target='#collapse_resources' data-toggle='collapse' href=''>
          <%= t(%q{Resources}) %>
        </a>
      </h4>
    </div>
    <div class='panel-collapse collapse in' id='collapse_resources' ng-show='age &gt; 0'>
      <div class='panel-body'>
        <div class='alert alert-danger alert-dismissable' ng-repeat="warn in alertsOfType('resources', 'warn')">
          <button aria-hidden='true' class='close' ng-click="removeAlert('resources',warn)" type='button'>&times;</button>
          {{warn}}
        </div>
        <strong><%= t(%q{Remaining:}) %></strong>
        <%= t(%q{{{unspentResourcePoints}}/{{totalResourcePoints}} rps}) %>
        <br>
        <br>
        <ul class='list-group' id='resources-list-group' ng-show='hashValues(gear).length &gt; 0 || hashValues(relationships).length &gt; 0 || hashValues(affiliations).length &gt; 0 || hashValues(reputations).length &gt; 0 || hashValues(property).length &gt; 0'>
          <li class='list-group-item'>
            <div class='container'>
              <div class='row'>
                <div class='col-md-2'>
                  <strong><%= t(%q{Type}) %></strong>
                </div>
                <div class='col-md-5'>
                  <strong><%= t(%q{Desc}) %></strong>
                </div>
                <div class='col-md-1'>
                  <strong><%= t(%q{Cost}) %></strong>
                </div>
              </div>
            </div>
          </li>
          <li class='list-group-item' ng-repeat='gear in hashValues(gear)'>
            <div class='container'>
              <div class='row'>
                <div class='col-md-2'>
                  <%= t(%q{Gear}) %>
                </div>
                <div class='col-md-5'>
                  {{gear.forDisplay()}}
                </div>
                <div class='col-md-1'>
                  {{gear.cost}}
                </div>
                <div class='col-md-1'>
                  <a href='' ng-click="removeResource('gear', gear)"><%= t(%q{remove}) %></a>
                </div>
              </div>
            </div>
          </li>
          <li class='list-group-item' ng-repeat='property in hashValues(property)'>
            <div class='container'>
              <div class='row'>
                <div class='col-md-2'>
                  <%= t(%q{Property}) %>
                </div>
                <div class='col-md-5'>
                  {{property.forDisplay()}}
                </div>
                <div class='col-md-1'>
                  {{property.cost}}
                </div>
                <div class='col-md-1'>
                  <a href='' ng-click="removeResource('property', property)"><%= t(%q{remove}) %></a>
                </div>
              </div>
            </div>
          </li>
          <li class='list-group-item' ng-repeat='rel in hashValues(relationships)'>
            <div class='container'>
              <div class='row'>
                <div class='col-md-2'>
                  <%= t(%q{Relationship}) %>
                </div>
                <div class='col-md-5'>
                  {{rel.forDisplay()}}
                </div>
                <div class='col-md-1'>
                  {{rel.cost}}
                </div>
                <div class='col-md-1'>
                  <a href='' ng-click="removeResource('relationship', rel)"><%= t(%q{remove}) %></a>
                </div>
              </div>
            </div>
          </li>
          <li class='list-group-item' ng-repeat='rel in hashValues(affiliations)'>
            <div class='container'>
              <div class='row'>
                <div class='col-md-2'>
                  <%= t(%q{Affiliation}) %>
                </div>
                <div class='col-md-5'>
                  {{rel.forDisplay()}}
                </div>
                <div class='col-md-1'>
                  {{rel.cost}}
                </div>
                <div class='col-md-1'>
                  <a href='' ng-click="removeResource('affiliation', rel)"><%= t(%q{remove}) %></a>
                </div>
              </div>
            </div>
          </li>
          <li class='list-group-item' ng-repeat='rel in hashValues(reputations)'>
            <div class='container'>
              <div class='row'>
                <div class='col-md-2'>
                  <%= t(%q{Reputation}) %>
                </div>
                <div class='col-md-5'>
                  {{rel.forDisplay()}}
                </div>
                <div class='col-md-1'>
                  {{rel.cost}}
                </div>
                <div class='col-md-1'>
                  <a href='' ng-click="removeResource('reputation', rel)"><%= t(%q{remove}) %></a>
                </div>
              </div>
            </div>
          </li>
        </ul>
        <div class='container'>
          <div class='row'>
            <div class='col-md-2'>
              <strong><%= t(%q{Select Category}) %></strong>
            </div>
            <div class='col-md-2'>
              <select class='form-control' ng-model='resourceAdderToShow'>
                <option value='gear'><%= t(%q{Gear}) %></option>
                <option value='property'><%= t(%q{Property}) %></option>
                <option value='relationship'><%= t(%q{Relationship}) %></option>
                <option value='affiliation'><%= t(%q{Affiliation}) %></option>
                <option value='reputation'><%= t(%q{Reputation}) %></option>
              </select>
            </div>
          </div>
          <div class='row'>
            <div class='col-md-2'>
              <h4 ng-show="resourceAdderToShow == 'gear'"><%= t(%q{Add Gear}) %></h4>
              <h4 ng-show="resourceAdderToShow == 'property'"><%= t(%q{Add Property}) %></h4>
              <h4 ng-show="resourceAdderToShow == 'relationship'"><%= t(%q{Add Relationship}) %></h4>
              <h4 ng-show="resourceAdderToShow == 'affiliation'"><%= t(%q{Add Affiliation}) %></h4>
              <h4 ng-show="resourceAdderToShow == 'reputation'"><%= t(%q{Add Reputation}) %></h4>
            </div>
          </div>
        </div>
        <div class='container' ng-show="resourceAdderToShow == 'gear'">
          <div class='row'>
            <div class='col-md-3'>
              <select class='form-control' ng-change='calculateHierarchyListForSelectN(gearListForSelect, currentSelectListGear, 1)' ng-model='currentSelectListGear[0]' ng-options='s as (s.displayName | tr) for s in gearListForSelect[0]'></select>
            </div>
            <div class='col-md-3' ng-show='gearListForSelect[1].length &gt; 0'>
              <select class='form-control' ng-change='calculateHierarchyListForSelectN(gearListForSelect, currentSelectListGear, 2)' ng-model='currentSelectListGear[1]' ng-options='s as (s.displayName | tr) for s in gearListForSelect[1]'></select>
            </div>
            <div class='col-md-3' ng-show='gearListForSelect[2].length &gt; 0'>
              <select class='form-control' ng-model='currentSelectListGear[2]' ng-options='s as (s.displayName | tr) for s in gearListForSelect[2]'></select>
            </div>
            <div class='col-md-1'>
              <a href='' ng-click='addSelectListGear()'><%= t(%q{Add}) %></a>
            </div>
          </div>
          <div class='row'>
            <div class='col-md-1'>
              <br>
            </div>
          </div>
          <div class='row'>
            <div class='col-md-3'>
              <h4><%= t(%q{Add Custom Gear}) %></h4>
            </div>
          </div>
          <div class='row'>
            <div class='col-md-3'>
              <input class='form-control' id='name' ng-model='currentGearDesc' placeholder='<%= t(%q{Enter name/description}) %>' type='text'>
            </div>
            <div class='col-md-2'>
              <input class='form-control' id='cost' ng-model='currentGearCost' placeholder='<%= t(%q{Enter cost in rps}) %>' type='text'>
            </div>
            <div class='col-md-1'>
              <a href='' ng-click="addResource('gear')"><%= t(%q{Add}) %></a>
              <!-- %select{ :class => "form-control", "ng-options" => "s.name for s in burningData.gearListForSelect()" } -->
            </div>
          </div>
        </div>
        <div class='container' ng-show="resourceAdderToShow == 'property'">
          <div class='row'>
            <div class='col-md-3'>
              <select class='form-control' ng-change='calculateHierarchyListForSelectN(propertyListForSelect, currentSelectListProperty, 1)' ng-model='currentSelectListProperty[0]' ng-options='s as (s.displayName | tr) for s in propertyListForSelect[0]'></select>
            </div>
            <div class='col-md-3' ng-show='propertyListForSelect[1].length &gt; 0'>
              <select class='form-control' ng-change='calculateHierarchyListForSelectN(propertyListForSelect, currentSelectListProperty, 2)' ng-model='currentSelectListProperty[1]' ng-options='s as (s.displayName | tr) for s in propertyListForSelect[1]'></select>
            </div>
            <div class='col-md-3' ng-show='propertyListForSelect[2].length &gt; 0'>
              <select class='form-control' ng-model='currentSelectListProperty[2]' ng-options='s as (s.displayName | tr) for s in propertyListForSelect[2]'></select>
            </div>
            <div class='col-md-1'>
              <a href='' ng-click='addSelectListProperty()'><%= t(%q{Add}) %></a>
            </div>
          </div>
          <div class='row'>
            <div class='col-md-1'>
              <br>
            </div>
          </div>
          <div class='row'>
            <div class='col-md-3'>
              <h4><%= t(%q{Add Custom Property}) %></h4>
            </div>
          </div>
          <div class='row'>
            <div class='col-md-3'>
              <input class='form-control' id='name' ng-model='currentPropertyDesc' placeholder='<%= t(%q{Enter name/description}) %>' type='text'>
            </div>
            <div class='col-md-3'>
              <input class='form-control' id='cost' ng-model='currentPropertyCost' placeholder='<%= t(%q{Enter cost in rps}) %>' type='text'>
            </div>
            <div class='col-md-1'>
              <a href='' ng-click="addResource('property')"><%= t(%q{Add}) %></a>
            </div>
          </div>
        </div>
        <div class='container' ng-show="resourceAdderToShow == 'relationship'">
          <div class='row'>
            <div class='col-md-3'>
              <input class='form-control' id='name' ng-model='currentRelationshipDesc' placeholder='<%= t(%q{Enter description}) %>' type='text'>
            </div>
            <div class='col-md-2'>
              <select class='form-control' ng-model='currentRelationshipImportance' placeholder='<%= t(%q{test}) %>'>
                <option value='minor'><%= t(%q{Minor: 5 rps}) %></option>
                <option value='significant'><%= t(%q{Significant: 10 rps}) %></option>
                <option value='powerful'><%= t(%q{Powerful: 15 rps}) %></option>
              </select>
            </div>
            <div class='col-md-1'>
              <a href='' ng-click="addResource('relationship')"><%= t(%q{Add}) %></a>
            </div>
          </div>
          <div class='row'>
            <div class='col-md-2'>
              <input ng-model='currentRelationshipIsImmedFam' type='checkbox'><%= t(%q{Immediate family: -2 rps}) %></input>
            </div>
            <div class='col-md-2'>
              <input ng-model='currentRelationshipIsOtherFam' type='checkbox'><%= t(%q{Other family: -1 rps}) %></input>
            </div>
            <div class='col-md-2'>
              <input ng-model='currentRelationshipIsRomantic' type='checkbox'><%= t(%q{Romantic: -2 rps}) %></input>
            </div>
            <div class='col-md-2'>
              <input ng-model='currentRelationshipIsForbidden' type='checkbox'><%= t(%q{Forbidden: -1 rps}) %></input>
            </div>
            <div class='col-md-2'>
              <input ng-model='currentRelationshipIsHateful' type='checkbox'><%= t(%q{Hateful or Rivals: -2 rps}) %></input>
            </div>
          </div>
        </div>
        <div class='container' ng-show="resourceAdderToShow == 'affiliation'">
          <div class='row'>
            <div class='col-md-3'>
              <input class='form-control' id='affiliation' ng-model='currentAffiliationDesc' placeholder='<%= t(%q{Enter description}) %>' type='text'>
            </div>
            <div class='col-md-2'>
              <select class='form-control' ng-model='currentAffiliationImportance'>
                <option value='small'><%= t(%q{1D, Small, Local, or Specialized: 10 rps}) %></option>
                <option value='large'><%= t(%q{2D, Large, Regional, or Expansive: 25 rps}) %></option>
                <option value='national'><%= t(%q{3D, National, Powerful, or Ruling: 50 rps}) %></option>
              </select>
            </div>
            <div class='col-md-1'>
              <a href='' ng-click="addResource('affiliation')"><%= t(%q{Add}) %></a>
            </div>
          </div>
        </div>
        <div class='container' ng-show="resourceAdderToShow == 'reputation'">
          <div class='row'>
            <div class='col-md-3'>
              <input class='form-control' id='reputation' ng-model='currentReputationDesc' placeholder='<%= t(%q{Enter description}) %>' type='text'>
            </div>
            <div class='col-md-2'>
              <select class='form-control' ng-model='currentReputationImportance'>
                <option value='local'><%= t(%q{1D, Local or Minor: 7 rps}) %></option>
                <option value='regional'><%= t(%q{2D, Regional or Notable: 25 rps}) %></option>
                <option value='national'><%= t(%q{3D, National or Major: 45 rps}) %></option>
              </select>
            </div>
            <div class='col-md-1'>
              <a href='' ng-click="addResource('reputation')"><%= t(%q{Add}) %></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<span id='versiontext'><%= t(%q{Charred v{{serverSettings.versionString}}}) %></span>